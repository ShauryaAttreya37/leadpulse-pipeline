# ==========================================
# LeadPulse Configuration (.env)
# ==========================================

# Server
APP_ENV=development
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Webhook Security Header Authentication (Production Protection)
# When set, all requests to /webhook/trigger and /webhook/ingest MUST supply:
# Header: X-API-Key: <your-secret-api-key>
API_KEY=

# Playwright Web Scraper Settings
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT_MS=25000
SCRAPE_DELAY_MS=800
BLOCK_ASSETS=true

# Google Sheets API Configuration
# Option A: Path to Google Service Account JSON file (e.g. service_account.json)
GOOGLE_SERVICE_ACCOUNT_FILE=
# Option B: Target existing Google Sheet ID (leave blank to auto-create by title)
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TITLE="B2B Real Estate Agencies - Clean Leads"

# Slack Webhook Configuration
# Incoming Webhook URL from https://api.slack.com/apps -> Incoming Webhooks
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=#b2b-leads

# Safe Simulation Fallback Mode
# If true, missing Google/Slack credentials will write to local audit files without crashing
ENABLE_SIMULATION_FALLBACK=true
